<bpmndi:BPMNShape id="t_buy_di" bpmnElement="t_buy"><dc:Bounds x="970" y="540" width="120" height="70"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ic_arr_di" bpmnElement="ic_arr"><dc:Bounds x="1132" y="557" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_res_di" bpmnElement="t_res"><dc:Bounds x="1210" y="445" width="120" height="70"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_do_di" bpmnElement="t_do"><dc:Bounds x="1380" y="315" width="120" height="70"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t_cls_di" bpmnElement="t_cls"><dc:Bounds x="1550" y="315" width="120" height="70"/></bpmndi:BPMNShape>
