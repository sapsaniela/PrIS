<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_TOiR" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_1"><bpmn:participant id="P_1" name="Процесс ТОиР оборудования (TO-BE)" processRef="Proc_TOiR"/></bpmn:collaboration>
<bpmn:process id="Proc_TOiR" isExecutable="false"><bpmn:laneSet id="LS_1">
<bpmn:lane id="L_op" name="Оператор оборудования"><bpmn:flowNodeRef>st_def</bpmn:flowNodeRef><bpmn:flowNodeRef>t_reg</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_m" name="Мастер участка"><bpmn:flowNodeRef>t_asg</bpmn:flowNodeRef><bpmn:flowNodeRef>t_chk</bpmn:flowNodeRef><bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_mech" name="Механик (ремонтник)"><bpmn:flowNodeRef>t_do</bpmn:flowNodeRef><bpmn:flowNodeRef>t_cls</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_sys" name="Система ТОиР (1С:ТОИР)"><bpmn:flowNodeRef>st_ppr</bpmn:flowNodeRef><bpmn:flowNodeRef>t_plan</bpmn:flowNodeRef><bpmn:flowNodeRef>t_req</bpmn:flowNodeRef><bpmn:flowNodeRef>g_mrg</bpmn:flowNodeRef><bpmn:flowNodeRef>t_stk</bpmn:flowNodeRef><bpmn:flowNodeRef>g_prt</bpmn:flowNodeRef><bpmn:flowNodeRef>t_buy</bpmn:flowNodeRef><bpmn:flowNodeRef>ic_arr</bpmn:flowNodeRef><bpmn:flowNodeRef>t_res</bpmn:flowNodeRef><bpmn:flowNodeRef>t_upd</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="st_def" name="Обнаружен дефект"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="t_reg" name="Зарегистрировать дефект (скан QR-кода)"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask>
<bpmn:startEvent id="st_ppr" name="Наступил срок ППР"><bpmn:outgoing>f3</bpmn:outgoing><bpmn:timerEventDefinition id="TED_st_ppr"/></bpmn:startEvent>
<bpmn:serviceTask id="t_plan" name="Сформировать наряд по графику ППР"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t_req" name="Создать заявку, уведомить мастера"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_mrg" name=""><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t_asg" name="Оценить приоритет, назначить механика"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t_stk" name="Проверить остатки ЗИП в 1С"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_prt" name="Запчасти есть?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_buy" name="Сформировать заявку на закупку"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="ic_arr" name="Запчасти поступили"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:messageEventDefinition id="MED_ic_arr"/></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="t_res" name="Зарезервировать запчасти под наряд"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="t_do" name="Выполнить работы по наряду (моб. приложение)"><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t_cls" name="Закрыть наряд: фото, время, запчасти"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t_upd" name="Списать ЗИП, обновить историю отказов, пересчитать ППР"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="t_chk" name="Проверить и подтвердить выполнение"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g_ok" name="Работы приняты?"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing><bpmn:outgoing>f19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="end" name="Наряд закрыт"><bpmn:incoming>f18</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="st_def" targetRef="t_reg"/>
<bpmn:sequenceFlow id="f2" name="" sourceRef="t_reg" targetRef="t_req"/>
<bpmn:sequenceFlow id="f3" name="" sourceRef="st_ppr" targetRef="t_plan"/>
<bpmn:sequenceFlow id="f4" name="" sourceRef="t_plan" targetRef="g_mrg"/>
<bpmn:sequenceFlow id="f5" name="" sourceRef="t_req" targetRef="g_mrg"/>
<bpmn:sequenceFlow id="f6" name="" sourceRef="g_mrg" targetRef="t_asg"/>
<bpmn:sequenceFlow id="f7" name="" sourceRef="t_asg" targetRef="t_stk"/>
<bpmn:sequenceFlow id="f8" name="" sourceRef="t_stk" targetRef="g_prt"/>
<bpmn:sequenceFlow id="f9" name="Да" sourceRef="g_prt" targetRef="t_res"/>
<bpmn:sequenceFlow id="f10" name="Нет" sourceRef="g_prt" targetRef="t_buy"/>
<bpmn:sequenceFlow id="f11" name="" sourceRef="t_buy" targetRef="ic_arr"/>
<bpmn:sequenceFlow id="f12" name="" sourceRef="ic_arr" targetRef="t_res"/>
<bpmn:sequenceFlow id="f13" name="" sourceRef="t_res" targetRef="t_do"/>
<bpmn:sequenceFlow id="f14" name="" sourceRef="t_do" targetRef="t_cls"/>
<bpmn:sequenceFlow id="f15" name="" sourceRef="t_cls" targetRef="t_upd"/>
<bpmn:sequenceFlow id="f16" name="" sourceRef="t_upd" targetRef="t_chk"/>
<bpmn:sequenceFlow id="f17" name="" sourceRef="t_chk" targetRef="g_ok"/>
<bpmn:sequenceFlow id="f18" name="Да" sourceRef="g_ok" targetRef="end"/>
<bpmn:sequenceFlow id="f19" name="Нет" sourceRef="g_ok" targetRef="t_do"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="D_1"><bpmndi:BPMNPlane id="Pl_1" bpmnElement="Collab_1">
<bpmndi:BPMNShape id="P_1_di" bpmnElement="P_1" isHorizontal="true"><dc:Bounds x="0" y="0" width="2200" height="640"/></bpmndi:BPMNShape>
